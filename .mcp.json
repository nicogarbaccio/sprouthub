{
  "mcpServers": {
    "netlify": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-netlify"
      ],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "playwright-mcp-server"
      ]
    },
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@latest",
        "experimental:mcp"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "supabase-mcp-server@latest"
      ]
    }
  }
}